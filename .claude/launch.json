{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dlicom",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),fs=require('fs'),p=require('path');const R='E:/dlicom';const M={html:'text/html',js:'application/javascript',json:'application/json',css:'text/css',png:'image/png',jpg:'image/jpeg',svg:'image/svg+xml',webm:'video/webm',webp:'image/webp'};h.createServer((req,res)=>{let u=req.url.split('?')[0];if(u==='/'||u==='/lb'){res.writeHead(302,{Location:'/lb/'});return res.end()}if(u==='/cards'){res.writeHead(302,{Location:'/cards/'});return res.end()}if(u==='/analytics'){res.writeHead(302,{Location:'/analytics/'});return res.end()}let f;if(u==='/lb/')f=p.join(R,'lb/index.html');else if(u==='/cards/')f=p.join(R,'index.html');else if(u==='/analytics/')f=p.join(R,'analytics/index.html');else f=p.join(R,u);try{const d=fs.readFileSync(f);res.writeHead(200,{'Content-Type':M[f.split('.').pop().toLowerCase()]||'text/plain'});res.end(d)}catch(e){res.writeHead(404);res.end('Not found: '+u)}}).listen(3456)"],
      "port": 3456
    }
  ]
}
